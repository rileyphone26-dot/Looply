{
  "name": "Nova — Short Videos",
  "short_name": "Nova",
  "description": "A short-video community. Watch, create and share on Nova.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#080808",
  "theme_color": "#080808",
  "categories": [
    "social",
    "video",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icons/launchericon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/launchericon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
